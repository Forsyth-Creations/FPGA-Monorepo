# Vivado writes these next to wherever it was launched.
*.log
*.jou
*.str
.Xil/

# Build artifacts collected by scripts/build.tcl.
/dist/

# Throwaway xsim work library and snapshots, recreated by scripts/sim.sh on
# every run. Same rule as /build/ -- nothing in here is a source.
/sim_build/

# The entire Vivado project is generated by scripts/build.tcl on every build
# from rtl/, constraints/ and bd/design_1.tcl. Nothing in here is a source --
# deleting it costs a rebuild and nothing else.
/build/
