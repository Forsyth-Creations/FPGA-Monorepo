{
  "globalDependencies": [".env"],
  "ui": "tui",
  "tasks": {
    "build_platform": {
      "outputs": ["dist/**"],
      "env": ["VIVADO_ROOT"],
      "inputs": [
        "package.json",
        "scripts/build.sh",
        "scripts/build.tcl",
        "scripts/xilinx-env.sh",
        "project_1/project_1.srcs/**",
        "!project_1/project_1.srcs/utils_1/**",
        "!project_1/project_1.srcs/sources_1/bd/*/ui/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "target/release/**"
      ]
    },
    "@repo/backend#build": {
      "dependsOn": ["@repo/fpga#build_platform"],
      "outputs": ["target/release/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "deploy": {
      "cache": false,
      "env": ["VIVADO_ROOT"],
      "dependsOn": ["@repo/backend#build"]
    }
  }
}
