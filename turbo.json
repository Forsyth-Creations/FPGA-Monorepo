{
  "globalDependencies": [
    ".env"
  ],
  "ui": "tui",
  "tasks": {
    "simulate": {
      "outputs": [],
      "env": [
        "VIVADO_ROOT"
      ],
      "inputs": [
        "package.json",
        "scripts/**",
        "rtl/**",
        "ip/**",
        "sim/**"
      ]
    },
    "build_platform": {
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VIVADO_ROOT"
      ],
      "inputs": [
        "package.json",
        "scripts/**",
        "rtl/**",
        "ip/**",
        "constraints/**",
        "bd/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "target/release/**"
      ]
    },
    "@repo/backend#build": {
      "dependsOn": [
        "@repo/fpga#build_platform"
      ],
      "outputs": [
        "target/release/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "deploy": {
      "cache": false,
      "env": [
        "VIVADO_ROOT"
      ],
      "dependsOn": [
        "@repo/backend#build"
      ]
    }
  }
}
